# ── App ──
ENVIRONMENT=development
PORT=8000
FRONTEND_URL=http://localhost:8000

# ── 資料主權：Railway PostgreSQL（SQLAlchemy DSN）──
DATABASE_URL=postgresql+psycopg2://orderai:orderai@localhost:5432/orderai

# ── Auth ──
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── LINE 兩支 channel 完全分離（嚴禁共用變數名）──
# Messaging channel：webhook 驗簽 + reply/push
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
# Login channel：OAuth authorize + token 交換
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_CALLBACK_URL=http://localhost:8000/api/v1/auth/line/callback

# ── LLM Provider（可替換、以 HTTP Adapter 呼叫）──
# 支援 http_chat / ollama / anthropic；所有 Key、端點與模型均由部署環境注入。
LLM_PROVIDER=http_chat
LLM_API_KEY=replace-in-deployment
LLM_API_BASE=https://llm-gateway.example/v1
LLM_MODEL=replace-in-deployment
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=0
LLM_ALLOW_EMPTY_API_KEY=false
# W2：備援 Provider。留空即停用；啟用時使用獨立端點、模型與憑證，不共用主 Provider 設定。
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=replace-in-deployment
LLM_FALLBACK_API_BASE=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_TEMPERATURE=0
LLM_FALLBACK_TIMEOUT_SECONDS=60
LLM_FALLBACK_MAX_RETRIES=0
LLM_FALLBACK_ALLOW_EMPTY_API_KEY=false

# ── AI 自動化（律八）──
AI_CONFIDENCE_THRESHOLD=0.85
AI_MAX_ITEMS_PER_ORDER=30
AI_MAX_QUANTITY_PER_ITEM=99

# ── PR-2：Redis / Queue（情境一）──
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis
QUEUE_NAME=line_webhook

# ── 青泉谷 P1：LINE 入站事件帳本與待確認草稿 ──
# 預設關閉；啟用時兩把 key 均為部署環境的獨立 secret，絕不提交真值。
P1_INTAKE_ENABLED=false
P1_PII_ENCRYPTION_KEY=replace-with-fernet-key-in-deployment
P1_IDENTITY_HMAC_KEY=replace-with-random-hmac-key-in-deployment
# LINE webhook JSON 的 destination（官方帳號 Bot user ID）；啟用 P1 時必填且精準比對。
# 不是 Channel ID、不是 channel secret，也不是 access token。
P1_LINE_DESTINATION=
# readiness 判定 processing 事件是否卡住的秒數；1～604800，缺失或非法時 fail-closed。
P1_PROCESSING_STALE_AFTER_SECONDS=300
# 僅在官方 Messaging channel 已配置且政策允許時才可發附件文字補問。
P1_ATTACHMENT_FOLLOWUP_ENABLED=false
P1_ATTACHMENT_MAX_BYTES=10000000
# 內部同仁的 LINE userId 清單，以逗號分隔；這些來源不可自動視為訂購人。
P1_INTERNAL_RELAY_LINE_USER_IDS=
# 雲鼎目標租戶 mapping。OrderAI 與雲鼎的內部 company_id 不可假定相同；
# 0 代表未設定，P1 不建立 ERP outbox，維持人工覆核。
P1_ERP_TARGET_COMPANY_ID=0
# 雲鼎銷售據點 mapping。0 代表未設定，P1 維持 blocked／人工覆核。
P1_ERP_SALES_LOCATION_ID=0
# OrderAI 本地商品 ID 到雲鼎商品 ID 的 JSON 映射；未映射品項不可送 ERP。
# 例如：{"12":345}；正式值僅能由受控部署的 secret/config 注入。
P1_ERP_PRODUCT_ID_MAP_JSON={}
# 受控 ERP Adapter 預設關閉。只有已核定的測試或自有部署環境可設為 http；
# 本設定不會自行啟動 outbox 傳送程序。
P1_ERP_INGEST_PROVIDER=blocked
P1_ERP_BASE_URL=
P1_ERP_SERVICE_ID=orderai_p1
P1_ERP_INGRESS_HMAC_SECRET=
P1_ERP_TIMEOUT_SECONDS=10
# 僅限 localhost／隔離整合驗收，預設關閉。不得設為正式雲鼎端點。
P1_ISOLATED_DELIVERY_ENABLED=false
P1_ERP_ISOLATED_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# 外部 UAT 送件與 localhost 模式完全分離；三個條件任一缺少即拒絕：
# ENVIRONMENT=uat、P1_UAT_ENVIRONMENT_MARKER=qingquan-p1-uat、精準 HTTPS host allowlist。
# 禁止使用萬用網域、正式 ERP host 或 production 環境。真實值只由隔離部署環境注入。
P1_UAT_DELIVERY_ENABLED=false
P1_UAT_ENVIRONMENT_MARKER=
P1_ERP_UAT_ALLOWED_HOSTS=
# 僅限手動執行 scripts/p1_uat_seed.py 的隔離合成基準；production 一律維持 false／空值。
P1_UAT_SEED_ENABLED=false
# 必須與 DATABASE_URL 完全一致，且必須是隔離資料庫的 .railway.internal host。
P1_UAT_DATABASE_HOST=
# 僅供隔離 UAT 手動真實 HMAC 驗收；需同時啟用 P1_INTAKE_ENABLED 與 P1_UAT_DELIVERY_ENABLED。
P1_UAT_DIRECT_ACCEPTANCE_ENABLED=false
# 僅限 staging synthetic UAT Portal；四項必須同時成立，且仍受既有 UAT DB/company/store guard 保護。
P1_UAT_PORTAL_ENABLED=false
P1_UAT_PORTAL_ENVIRONMENT=
RAILWAY_ENVIRONMENT_NAME=
P1_UAT_PORTAL_ACCESS_CODE=replace-with-staging-only-access-code

# ── PR-2：StallPay 金流橋接（情境四）──
STALLPAY_API_BASE=https://api.stallpay.merchcore.ai
STALLPAY_API_KEY=

# ── i18n ──
DEFAULT_LANG=zh-Hant-TW
